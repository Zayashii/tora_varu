# Vercel → Project → Settings → Environment Variables хэсэгт оруулна.
# Локалд ажиллуулахдаа энэ файлыг .env.local нэрээр хуулна.

# Сайтын үндсэн хаяг (SEO, Open Graph холбоосод)
NEXT_PUBLIC_SITE_URL=https://toravaru.mn

# "Уулзалт товлох" маягтын хүсэлтийг дамжуулах webhook хаяг.
# Хоосон үлдээвэл маягт хэрэглэгчид и-мэйлээр илгээх сонголт харуулна.
MEETING_WEBHOOK_URL=

# (Заавал биш) Хуучин backend. Vercel HTTPS-ээс http:// хаяг руу шууд хандах
# боломжгүй тул /api/backend/* замаар дамжуулна.
API_ORIGIN=http://103.50.206.205:3030
NEXT_PUBLIC_HOST_API=/api/backend
